-machine
q35,accel=kvm:tcg
-cpu
max
-smp
4
-m
6144M
-object
iothread,id=io0
-blockdev
driver=nbd,node-name=nbd0,server.type=inet,server.host=server,server.port=10809,reconnect-delay=10,cache.direct=off,cache.no-flush=off
-device
virtio-blk,drive=nbd0,iothread=io0,write-cache=on,bootindex=0
-device
qemu-xhci,id=xhci
-device
usb-tablet,bus=xhci.0
-nic
user,model=virtio-net-pci,restrict=on
-device
virtio-serial-pci
-device
virtserialport,chardev=charchannel0,id=channel0,name=com.redhat.spice.0
-chardev
qemu-vdagent,id=charchannel0,name=vdagent,clipboard=on
-vga
virtio
-display
gtk,gl=on
-audiodev
pa,id=audio0
-device
virtio-sound-pci,audiodev=audio0
-rtc
base=localtime
