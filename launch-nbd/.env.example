# =============================================================================
# launch-nbd.sh — configurazione locale
#
# Copia questo file in ".env" e adatta i valori alla tua macchina.
# ".env" è gitignorato: i tuoi valori non finiscono nel repository.
#
# Il file viene ESEGUITO COME SHELL SCRIPT da launch-nbd.sh, quindi:
#   - rispetta la sintassi bash (niente spazi intorno a "=")
#   - i flag da riga di comando (--display, --overlay, ...) hanno la precedenza
#     sui valori qui definiti
#   - le variabili d'ambiente esportate vengono sovrascritte da questo file
# =============================================================================

# --- disco NBD --------------------------------------------------------------
# Host/IP del server che esegue nbdkit sulla porta NBD_PORT
NBD_HOST=server
NBD_PORT=10809
# Nome dell'export creato da nbdkit sul server (vedi nbd-export.sh <immagine> --name)
NBD_EXPORT=fdbnode
# URI completo dell'esportazione; derivato da NBD_HOST/NBD_PORT/NBD_EXPORT se non impostato
# NBD_URI=nbd://${NBD_HOST}:${NBD_PORT}/${NBD_EXPORT}

# --- binari e risorse della VM -----------------------------------------------
QEMU=qemu-system-x86_64
QEMU_IMG=qemu-img
MEM_MB=6144
CPUS=4

# --- caching / performance NBD ------------------------------------------------
CACHE_MODE=writeback      # writeback | none | unsafe | writethrough | directsync
AIO=io_uring              # io_uring | native | threads
RECONNECT_DELAY=10        # secondi di interruzione NBD tollerati da QEMU
QCACHE_MB=64              # cache metadata qcow2 (overlay, MiB)
L2_CACHE_MB=16            # cache tabelle L2 qcow2 (overlay, MiB)

# --- display / vga / audio -----------------------------------------------------
DISPLAY_MODE=spice        # spice | gtk | sdl | vnc | none | auto
SPICE_PORT=5930           # porta del server SPICE (solo con DISPLAY_MODE=spice)
VGA_MODE=virtio           # virtio | std | qxl | vmware | none
GL=auto                   # auto | on | off (virgl 3D, solo con VGA_MODE=virtio)
AUDIO_MODE=hda            # hda | virtio | none
AUDIO_DRV=auto            # auto | pipewire | pa | sdl | none (backend host)

# --- rete ----------------------------------------------------------------------
NET_MODE=dual             # dual | nat | hostonly | tap | bridged | none
TAP_DEV=tap0              # device TAP per --net tap/dual
TAP_SUBNET=192.168.100.0/24   # rete privata host .1 <-> guest .2
BRIDGE_IF=br0             # bridge per --net bridged

# --- accelerazione ---------------------------------------------------------------
ACCEL=auto                # auto | kvm | tcg