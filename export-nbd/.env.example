# =============================================================================
# nbd-export.sh — configurazione locale
#
# Copia questo file in ".env" e adatta i valori alla tua macchina.
# ".env" è gitignorato: i tuoi valori (nomi export, seriali, path, hostname)
# non finiscono nel repository.
#
# Il file viene ESEGUITO COME SHELL SCRIPT da nbd-export.sh, quindi:
#   - rispetta la sintassi bash (niente spazi intorno a "=")
#   - le variabili d'ambiente esportate vengono sovrascritte da questo file
#   - i valori omessi usano i default di nbd-export.sh
# =============================================================================

# --- ascolto NBD --------------------------------------------------------------
# Porta di default per gli export (--port omesso)
DEFAULT_PORT=10809
# Indirizzo su cui nbdkit ascolta (--addr omesso)
DEFAULT_ADDR=0.0.0.0

# --- unit systemd --------------------------------------------------------------
# Prefisso del nome delle unit generate (nbd-export-<name>.service)
UNIT_PREFIX=nbd-export
# Directory dove vengono scritte le unit
UNIT_DIR=/etc/systemd/system

# --- TLS ----------------------------------------------------------------------
# Directory dei certificati (solo se diversa dal default di sistema)
# TLS_DIR_DEFAULT=/etc/pki/nbdkit

# --- test d'integrazione (root) -------------------------------------------------
# Valori reali usati dai test in tests/. In .env.example sono placeholder.
# TEST_EXPORT_NAME=esempio
# TEST_BYID=/dev/disk/by-id/ata-ESEMPIO_VENDOR_SERIAL-part3
